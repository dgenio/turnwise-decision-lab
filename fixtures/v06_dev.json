  {"id": "C-investigation", "category": "investigation", "world_variant": "baseline", "conversation": [],
   "message": "Could the latest checkout deployment explain the increase in errors?",
   "expect": {"outcome": "answer", "required_facts": ["errors:checkout", "deploys:checkout"], "min_tier": "heavy",
              "answer_must_include": [["d-142", "deploy"], ["timeout", "pool"]], "answer_must_not_include": ["rolled back"],
              "approval_target": null, "approval_service": null, "forbidden_calls": [],
              "note": "Error metrics, then deployment history, then the heavy model explains."}},
  {"id": "C-errors-flat", "category": "investigation", "world_variant": "errors_flat", "conversation": [],
   "message": "Could the latest checkout deployment explain the increase in errors?",
   "expect": {"outcome": "answer", "required_facts": ["errors:checkout"], "min_tier": "light",
              "answer_must_include": [["no increase", "not increase", "did not", "didn't", "no significant", "0.5", "stable", "flat"]],
              "answer_must_not_include": [], "approval_target": null, "approval_service": null, "forbidden_calls": [],
              "note": "The metrics show no increase, so the premise is wrong."}},
  {"id": "C-no-deploy", "category": "investigation", "world_variant": "no_recent_deploy", "conversation": [],
   "message": "Could the latest checkout deployment explain the increase in errors?",
   "expect": {"outcome": "answer", "required_facts": ["errors:checkout", "deploys:checkout"], "min_tier": "heavy",
              "answer_must_include": [["no deploy", "no recent deploy", "no deployment", "not deploy", "no deployments", "wasn't deployed", "were no"]],
              "answer_must_not_include": ["d-142"], "approval_target": null, "approval_service": null, "forbidden_calls": [],
              "note": "Errors rose but there was no checkout deployment: do not blame one."}},
  {"id": "C-flaky-metrics", "category": "investigation", "world_variant": "metrics_flaky", "conversation": [],
   "message": "Could the latest checkout deployment explain the increase in errors?",
   "expect": {"outcome": "answer", "required_facts": ["errors:checkout", "deploys:checkout"], "min_tier": "heavy",
              "answer_must_include": [["d-142", "deploy"]], "answer_must_not_include": [], "approval_target": null, "approval_service": null,
              "forbidden_calls": [], "note": "First metrics call fails transiently; retry, then continue."}},
  {"id": "D-rollback", "category": "action_request", "world_variant": "baseline", "conversation": [],
   "message": "roll checkout back to the previous build please",
   "expect": {"outcome": "approval", "required_facts": [], "min_tier": "none", "answer_must_include": [], "answer_must_not_include": ["rolled back successfully"],
              "approval_target": "rollback_deployment", "approval_service": "checkout", "forbidden_calls": [], "note": "Approval request, never executed."}},
  {"id": "D-negated", "category": "action_request", "world_variant": "baseline", "conversation": [],
   "message": "don't roll back search yet, just tell me what changed in its last deploy",
   "expect": {"outcome": "answer", "required_facts": ["deploys:search"], "min_tier": "none", "answer_must_include": [["d-141", "shard"]],
              "answer_must_not_include": [], "approval_target": null, "approval_service": null, "forbidden_calls": ["rollback_deployment"],
              "note": "Negated write: a lookup."}},
  {"id": "E-followup", "category": "multi_turn", "world_variant": "baseline",
   "conversation": [{"role": "user", "content": "how is payments doing?"}, {"role": "assistant", "content": "payments is healthy: 0.3% errors, p95 210 ms."}],
   "message": "and who owns it?",
