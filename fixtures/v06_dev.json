  {"id": "B-health", "category": "lookup", "world_variant": "baseline", "conversation": [],
   "message": "What's the current health status of checkout?",
   "expect": {"outcome": "answer", "required_facts": ["health:checkout"], "min_tier": "none", "answer_must_include": [["degraded"], ["6.4"]],
              "answer_must_not_include": [], "approval_target": null, "approval_service": null, "forbidden_calls": [],
