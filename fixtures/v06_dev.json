  {"id": "I-search-slow", "category": "investigation", "world_variant": "baseline", "conversation": [],
   "message": "why has search been so slow since this morning?",
   "expect": {"outcome": "answer", "required_facts": ["deploys:search"], "min_tier": "heavy", "answer_must_include": [["shard", "d-141", "index"]],
              "answer_must_not_include": [], "approval_target": null, "approval_service": null, "forbidden_calls": [],
              "note": "The reindex with fewer shards explains the latency."}}
 ]
